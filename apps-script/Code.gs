function indicatorTrend_(inds){var d=rows_('IndicatorData').filter(function(x){return projectAllowed_(x['Project ID']);}),out={};d.forEach(function(x){var k=String(x.Period||'Unspecified');out[k]=(out[k]||0)+(Number(x.Achievement)||0);});return Object.keys(out).sort().map(function(k){return {period:k,achievement:out[k]};});}
