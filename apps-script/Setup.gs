function dashboard_(){var p=rows_('Projects').filter(function(x){return projectAllowed_(x['Project ID']);}),b=rows_('Beneficiaries').filter(function(x){return projectAllowed_(x['Project ID']);}),i=rows_('Indicators').filter(function(x){return projectAllowed_(x['Project ID']);}),done=b.filter(function(x){return String(x['Current Stage']).toLowerCase()=='completed';}).length;var ip=i.map(function(x){var t=Number(x.Target)||0,c=Number(x['Current Achievement'])||0,q=t?Math.round(c/t*10000)/100:0;return Object.assign({},x,{Percentage:q,RAG:q>=100?'Green':q>=70?'Amber':'Red'});});var stages={};JOURNEY.forEach(function(s){stages[s]=b.filter(function(x){return x['Current Stage']==s;}).length;});var pp=p.map(function(x){var pb=b.filter(function(y){return y['Project ID']==x['Project ID'];}),pi=i.filter(function(y){return y['Project ID']==x['Project ID'];});var ach=pi.length?Math.round(pi.reduce(function(a,y){var t=Number(y.Target)||0,c=Number(y['Current Achievement'])||0;return a+(t?c/t*100:0);},0)/pi.length*100)/100:0;return {'Project Name':x['Project Name'],ProjectId:x['Project ID'],Beneficiaries:pb.length,Completed:pb.filter(function(y){return y['Current Stage']=='Completed';}).length,IndicatorAchievement:ach};});return json_({ok:true,projects:p.filter(function(x){return String(x.Status).toLowerCase()!='completed'&&String(x.Status).toLowerCase()!='inactive';}).length,beneficiaries:b.length,indicators:i.length,completed:done,indicatorPerformance:ip,projectPerformance:pp,stageCounts:stages,alerts:alerts_().length});}
function validate_(entity,o){var required={project:['Project Name','Code'],objective:['Project ID','Objective'],activity:['Project ID','Activity'],indicator:['Project ID','Indicator'],beneficiary:['Project ID','Full Name','Consent'],followup:['Beneficiary ID','Project ID','Date','Stage'],evidence:['Project ID','Date','Evidence Type'],lesson:['Project ID','Date','Lesson'],challenge:['Project ID','Date','Challenge']}[entity]||[];required.forEach(function(k){if(o[k]===undefined||String(o[k]).trim()==='')throw Error(k+' is required.');});if(entity==='beneficiary'&&String(o.Consent).toLowerCase()!=='yes')throw Error('Parent/guardian consent is required.');if(entity==='indicator'&&(isNaN(Number(o.Target))||Number(o.Target)<0))throw Error('Indicator target must be a non-negative number.');if(entity==='indicator'&&o.Baseline!==undefined&&o.Baseline!==''&&(isNaN(Number(o.Baseline))||Number(o.Baseline)<0))throw Error('Indicator baseline must be a non-negative number.');}
function duplicateBeneficiary_(o){var b=rows_('Beneficiaries'),name=String(o['Full Name']||'').trim().toLowerCase(),dob=String(o['Date of Birth']||'').trim(),phone=String(o.Phone||'').replace(/\D/g,'');return b.filter(function(x){if(String(x['Project ID'])!=String(o['Project ID']))return false;var sameName=String(x['Full Name']).trim().toLowerCase()==name&&name;var samePhone=phone&&String(x.Phone||'').replace(/\D/g,'')==phone;var sameDob=dob&&String(x['Date of Birth'])==dob;return samePhone||(sameName&&sameDob)||(sameName&&String(x.Community).toLowerCase()==String(o.Community||'').toLowerCase());});}
function doPost(e){try{var d=JSON.parse(e.postData.contents||'{}'),a=d.action||'create';if(a==='currentUser')return currentUser_();if(a==='initializeStage3'||a==='initializeStage5'){permission_('update');return json_({ok:true,message:setupUAFMEL()});}if(a==='generateReport'){permission_('report',d.projectId);return generateReport_(d);}if(a==='create'){permission_('create',d.data&&d.data['Project ID']);return create_(d);}if(a==='update'){permission_('update',d.data&&d.data['Project ID']);return update_(d);}if(a==='delete'){permission_('update',d.projectId);return delete_(d);}if(a==='moveBeneficiary'){permission_('update');return moveBeneficiary_(d);}if(a==='recordIndicator'){permission_('update',d.projectId);return recordIndicator_(d);}if(a==='uploadEvidence'){permission_('create',d.projectId);return uploadEvidence_(d);}if(a==='runAlerts'){permission_('update');return json_({ok:true,count:refreshAlerts_()});}return json_({ok:false,error:'Unknown action'});}catch(err){return json_({ok:false,error:String(err)})}}
function create_(d){var map={project:'Projects',objective:'Objectives',activity:'Activities',indicator:'Indicators',beneficiary:'Beneficiaries',followup:'FollowUps',evidence:'Evidence',lesson:'Lessons',challenge:'Challenges'};var n=map[d.entity];if(!n)throw Error('Unsupported entity');var s=SpreadsheetApp.getActive().getSheetByName(n),h=HEADERS[n],o=d.data||{},now=new Date();validate_(d.entity,o);if(d.entity==='beneficiary'&&duplicateBeneficiary_(o).length)throw Error('Possible duplicate beneficiary: a matching record already exists in this project. Review before registering again.');var id=id_(d.entity.slice(0,3).toUpperCase());s.appendRow(h.map(function(k){return (k=='Created At'||k=='Updated At'||k=='Last Updated')?now:(o[k]!==undefined?o[k]:(k.indexOf(' ID')>0?id:''));}));audit_('CREATE',d.entity,id,o);return json_({ok:true,id:id});}
function update_(d){var s=SpreadsheetApp.getActive().getSheetByName(d.sheet);if(!s)throw Error('Sheet not found');var v=s.getDataRange().getValues(),h=v[0],c=h.indexOf(d.idField||h[0]),r=v.findIndex(function(x,n){return n>0&&String(x[c])==String(d.id);});if(r<1)throw Error('Record not found');Object.keys(d.data||{}).forEach(function(k){var q=h.indexOf(k);if(q>=0)s.getRange(r+1,q+1).setValue(d.data[k]);});audit_('UPDATE',d.sheet,d.id,d.data);return json_({ok:true});}
function delete_(d){var s=SpreadsheetApp.getActive().getSheetByName(d.sheet);if(!s)throw Error('Sheet not found');var v=s.getDataRange().getValues(),h=v[0],c=h.indexOf(d.idField||h[0]),r=v.findIndex(function(x,n){return n>0&&String(x[c])==String(d.id);});if(r<1)throw Error('Record not found');s.deleteRow(r+1);audit_('DELETE',d.sheet,d.id,d);return json_({ok:true});}
function moveBeneficiary_(d){var allowed=JOURNEY;if(allowed.indexOf(d.stage)<0)throw Error('Invalid stage');var s=SpreadsheetApp.getActive().getSheetByName('Beneficiaries'),v=s.getDataRange().getValues(),h=v[0],c=h.indexOf('Beneficiary ID'),r=v.findIndex(function(x,n){return n>0&&String(x[c])==String(d.id);});if(r<1)throw Error('Beneficiary not found');if(!projectAllowed_(v[r][h.indexOf('Project ID')]))throw Error('Forbidden: no project access.');s.getRange(r+1,h.indexOf('Current Stage')+1).setValue(d.stage);if(h.indexOf('Updated At')>=0)s.getRange(r+1,h.indexOf('Updated At')+1).setValue(new Date());if(d.followUp){var f=SpreadsheetApp.getActive().getSheetByName('FollowUps');f.appendRow([id_('FUP'),d.id,v[r][h.indexOf('Project ID')],new Date(),d.stage,d.followUp.schoolStatus||'',d.followUp.retentionStatus||'',d.followUp.householdStatus||'',d.followUp.notes||'',d.followUp.actionRequired||'',actor_(),d.followUp.nextFollowUp||'']);}audit_('STAGE_CHANGE','Beneficiary',d.id,{stage:d.stage});return json_({ok:true,id:d.id,stage:d.stage});}
function recordIndicator_(d){var ind=rows_('Indicators').filter(function(x){return String(x['Indicator ID'])==String(d.indicatorId);})[0];if(!ind)throw Error('Indicator not found');if(!projectAllowed_(ind['Project ID']))throw Error('Forbidden: no project access.');var n=Number((d.data||{}).Achievement);if(isNaN(n)||n<0)throw Error('Achievement must be a non-negative number.');var s=SpreadsheetApp.getActive().getSheetByName('IndicatorData'),rid=id_('INDD');s.appendRow([rid,d.indicatorId,ind['Project ID'],(d.data||{}).Period||'',(d.data||{})['Period Type']||'Monthly',n,(d.data||{}).Notes||'',actor_(),new Date()]);var total=rows_('IndicatorData').filter(function(x){return String(x['Indicator ID'])==String(d.indicatorId);}).reduce(function(a,x){return a+(Number(x.Achievement)||0);},0);var is=SpreadsheetApp.getActive().getSheetByName('Indicators'),iv=is.getDataRange().getValues(),ih=iv[0],ic=ih.indexOf('Indicator ID'),ac=ih.indexOf('Current Achievement'),rr=iv.findIndex(function(x,n){return n>0&&String(x[ic])==String(d.indicatorId);});if(rr>0&&ac>=0)is.getRange(rr+1,ac+1).setValue(total);audit_('INDICATOR_UPDATE','Indicator',d.indicatorId,d.data);return json_({ok:true,id:rid,currentAchievement:total});}
function uploadEvidence_(d){if(!d.base64||!d.fileName)throw Error('File data and file name are required.');if(Number(d.base64.length)>6000000)throw Error('File is too large for this web request. Use a smaller image/file.');var settings=rows_('Settings'),folderId=(settings.filter(function(x){return x.Key==='Evidence Folder ID';})[0]||{}).Value||'';var folder=folderId?DriveApp.getFolderById(folderId):DriveApp.getRootFolder();var bytes=Utilities.base64Decode(String(d.base64).split(',').pop());var blob=Utilities.newBlob(bytes,d.mimeType||'application/octet-stream',d.fileName);var file=folder.createFile(blob);var url=file.getUrl();var ev={};ev['Project ID']=d.projectId;ev['Activity ID']=d.activityId||'';ev['Indicator ID']=d.indicatorId||'';ev['Beneficiary ID']=d.beneficiaryId||'';ev.Date=d.date||new Date();ev['Evidence Type']=d.evidenceType||'Photo';ev.Description=d.description||'';ev['Drive URL']=url;ev['Collected By']=actor_();var r=create_({entity:'evidence',data:ev});return json_({ok:true,url:url,fileId:file.getId()});}
function alerts_(){return rows_('Alerts').filter(function(x){return String(x.Status).toLowerCase()!=='resolved';}).filter(function(x){return !x['Project ID']||projectAllowed_(x['Project ID']);});}
function refreshAlerts_(){var s=SpreadsheetApp.getActive().getSheetByName('Alerts');if(!s)return 0;var existing=rows_('Alerts').filter(function(x){return String(x.Status).toLowerCase()!=='resolved';});var seen={};existing.forEach(function(x){seen[String(x['Alert Type'])+'|'+String(x['Beneficiary ID'])+'|'+String(x['Indicator ID'])+'|'+String(x['Project ID'])]=true;});var count=0,today=new Date();rows_('FollowUps').forEach(function(f){if(!f['Next FollowUp'])return;var due=new Date(f['Next FollowUp']);if(due<today&&String(f['Retention Status']).toLowerCase()!=='retained'){var k='Overdue Follow-up|'+f['Beneficiary ID']+'||'+f['Project ID'];if(!seen[k]){s.appendRow([id_('ALT'),today,'Overdue Follow-up','High',f['Project ID'],f['Beneficiary ID'],'','Follow-up is overdue for beneficiary '+f['Beneficiary ID'],'Open',f['Next FollowUp'],f.Officer||'']);count++;}}});rows_('Indicators').forEach(function(i){var t=Number(i.Target)||0,c=Number(i['Current Achievement'])||0;if(t>0&&c/t<0.7){var k='Low KPI Performance||'+i['Indicator ID']+'|'+i['Project ID'];if(!seen[k]){s.appendRow([id_('ALT'),today,'Low KPI Performance','Medium',i['Project ID'],'',i['Indicator ID'],i.Indicator+' is below 70% of target.','Open','',i['Responsible Person']||'']);count++;}}});return count;}
function generateReport_(d){var p=rows_('Projects').filter(function(x){return String(x['Project ID'])==String(d.projectId);})[0];if(!p)throw Error('Project not found');var b=rows_('Beneficiaries').filter(function(x){return String(x['Project ID'])==String(d.projectId);}),i=rows_('Indicators').filter(function(x){return String(x['Project ID'])==String(d.projectId);}),doc=DocumentApp.create('UAF '+(d.reportType||'M&E Report')+' - '+p['Project Name']),body=doc.getBody();body.appendParagraph('Upskill Africa Foundation').setHeading(DocumentApp.ParagraphHeading.TITLE);body.appendParagraph(d.reportType||'M&E Report').setHeading(DocumentApp.ParagraphHeading.HEADING1);body.appendParagraph('Project: '+p['Project Name']+' ('+p['Code']+')');body.appendParagraph('Period: '+(d.periodStart||'')+' to '+(d.periodEnd||''));body.appendParagraph('Beneficiaries registered: '+b.length);body.appendParagraph('Beneficiaries completed: '+b.filter(function(x){return x['Current Stage']=='Completed';}).length);i.forEach(function(x){var t=Number(x.Target)||0,c=Number(x['Current Achievement'])||0;body.appendListItem(x.Indicator+': '+c+' / '+t+' '+(x.Unit||'')+' ('+(t?Math.round(c/t*10000)/100:0)+'%)');});doc.saveAndClose();var url=doc.getUrl(),rs=SpreadsheetApp.getActive().getSheetByName('Reports');if(rs)rs.appendRow([id_('RPT'),d.projectId,d.reportType||'M&E Report',d.periodStart||'',d.periodEnd||'',new Date(),actor_(),url]);audit_('REPORT_GENERATED','Report',d.projectId,{url:url});return json_({ok:true,url:url});}
function createDailyAlertsTrigger(){ScriptApp.getProjectTriggers().filter(function(t){return t.getHandlerFunction()==='refreshAlerts_';}).forEach(function(t){ScriptApp.deleteTrigger(t);});ScriptApp.newTrigger('refreshAlerts_').timeBased().everyDays(1).atHour(7).create();return 'Daily alert trigger created.';}
