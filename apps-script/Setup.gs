function setupUAFMEL(){var ss=SpreadsheetApp.getActive();Object.keys(HEADERS).forEach(function(n){var s=ss.getSheetByName(n)||ss.insertSheet(n);if(s.getLastRow()==0)s.appendRow(HEADERS[n]);s.setFrozenRows(1);});var s=ss.getSheetByName('Settings');var defaults={Organization:'Upskill Africa Foundation','System Name':'UAF Digital M&E/L System',Version:'5.0','Default Currency':'USD','Beneficiary Journey':JOURNEY.join(' → '),'Security Mode':'Role-based access via Users sheet','Stage 5':'Mobile data collection, evidence, validation and M&E alerts'};var old=rows_('Settings');Object.keys(defaults).forEach(function(k){if(!old.some(function(x){return x.Key==k;}))s.appendRow([k,defaults[k]]);});return 'Stage 5 setup complete; existing data preserved.';}
function json_(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON)}
function rows_(name){var s=SpreadsheetApp.getActive().getSheetByName(name);if(!s||s.getLastRow()<2)return [];var h=s.getRange(1,1,1,s.getLastColumn()).getValues()[0];return s.getRange(2,1,s.getLastRow()-1,s.getLastColumn()).getValues().map(function(r){var o={};h.forEach(function(k,i){o[k]=r[i];});return o;});}
function id_(p){return p+'-'+Utilities.getUuid().slice(0,8).toUpperCase()}
function actor_(){try{return Session.getActiveUser().getEmail()||Session.getEffectiveUser().getEmail()||'system';}catch(e){return 'system';}}
function user_(){var e=actor_(),u=rows_('Users').filter(function(x){return String(x.Email).toLowerCase()==String(e).toLowerCase()&&String(x.Status).toLowerCase()!='inactive';})[0]||null;return u;}
function projectAllowed_(projectId){var u=user_();if(!u)return false;if(String(u.Role)=='ED')return true;var access=String(u['Project Access']||'').trim();if(!access||access=='*')return true;var a=access.split(',').map(function(x){return x.trim().toLowerCase();});var p=rows_('Projects').filter(function(x){return String(x['Project ID']).toLowerCase()==String(projectId||'').toLowerCase()||String(x.Code).toLowerCase()==String(projectId||'').toLowerCase();})[0];return !!p&&(a.indexOf(String(p['Project ID']).toLowerCase())>=0||a.indexOf(String(p.Code).toLowerCase())>=0);}
function permission_(action,projectId){var u=user_();if(!u)throw Error('Unauthorized: add your Google account email to Users and set Status=Active.');var r=String(u.Role||'').trim();if(r==='ED')return true;var p=ROLES[r]||[];if(p.indexOf(action)<0)throw Error('Forbidden: your role cannot perform '+action+'.');if(projectId&& !projectAllowed_(projectId))throw Error('Forbidden: you do not have access to this project.');return true;}
