const SHEETS={SETTINGS:'Settings',PROJECTS:'Projects',OBJECTIVES:'Objectives',ACTIVITIES:'Activities',INDICATORS:'Indicators',BENEFICIARIES:'Beneficiaries',FOLLOWUPS:'FollowUps',EVIDENCE:'Evidence',LESSONS:'Lessons',CHALLENGES:'Challenges',REPORTS:'Reports',USERS:'Users'};
const HEADERS={
Settings:['Key','Value'],Projects:['Project ID','Project Name','Code','Description','Start Date','End Date','Status','Budget','Currency','Communities','Partners','Responsible Person','Created At'],Objectives:['Objective ID','Project ID','Objective','Description','Created At'],Activities:['Activity ID','Project ID','Objective ID','Activity','Community','Start Date','End Date','Status','Responsible Person','Budget','Actual Cost','Notes'],Indicators:['Indicator ID','Project ID','Objective ID','Indicator','Definition','Type','Baseline','Target','Current Achievement','Unit','Data Source','Frequency','Responsible Person','Last Updated'],Beneficiaries:['Beneficiary ID','Project ID','Full Name','Sex','Date of Birth','Age','Community','County','Phone','Guardian Name','School','School Status','Reason OOSC','Consent','Current Stage','Enrollment Date','Household Empowered','Retention Status','Completion Date','Story','Photo URL','Created At','Updated At'],FollowUps:['FollowUp ID','Beneficiary ID','Project ID','Date','Stage','School Status','Retention Status','Household Status','Notes','Action Required','Officer','Next FollowUp'],Evidence:['Evidence ID','Project ID','Activity ID','Indicator ID','Beneficiary ID','Date','Evidence Type','Description','Drive URL','Collected By'],Lessons:['Lesson ID','Project ID','Date','Lesson','What Worked','What Did Not Work','Recommendation','Recorded By'],Challenges:['Challenge ID','Project ID','Date','Challenge','Impact','Action Taken','Recommendation','Status','Responsible Person'],Reports:['Report ID','Project ID','Report Type','Period Start','Period End','Generated At','Generated By','Drive URL'],Users:['User ID','Name','Email','Role','Project Access','Status']};
function setupUAFMEL(){const ss=SpreadsheetApp.getActive();Object.keys(HEADERS).forEach(n=>{let s=ss.getSheetByName(n)||ss.insertSheet(n);s.clear();s.appendRow(HEADERS[n]);s.setFrozenRows(1);});const s=ss.getSheetByName('Settings');s.getRange(2,1,5,2).setValues([['Organization','Upskill Africa Foundation'],['System Name','UAF Digital M&E/L System'],['Version','1.0'],['Default Currency','USD'],['Beneficiary Journey','Identified → Verified → Referred → Enrolled → Household Empowered → Follow-up → Retained → Completed']]);}
function json_(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON)}
function rows_(name){const s=SpreadsheetApp.getActive().getSheetByName(name);if(!s||s.getLastRow()<2)return [];const h=s.getRange(1,1,1,s.getLastColumn()).getValues()[0];return s.getRange(2,1,s.getLastRow()-1,s.getLastColumn()).getValues().map(r=>Object.fromEntries(h.map((k,i)=>[k,r[i]])));}
function id_(prefix){return prefix+'-'+Utilities.getUuid().slice(0,8).toUpperCase()}
function doGet(e){const a=(e&&e.parameter&&e.parameter.action)||'dashboard';if(a==='dashboard')return dashboard_();if(a==='list')return json_({ok:true,data:rows_(e.parameter.sheet)});return json_({ok:true,system:'UAF Digital M&E/L',version:'1.0'});}
function dashboard_(){const p=rows_('Projects'),b=rows_('Beneficiaries'),i=rows_('Indicators');const completed=b.filter(x=>String(x['Current Stage']).toLowerCase()==='completed').length;const indicators=i.map(x=>{const t=Number(x.Target)||0,c=Number(x['Current Achievement'])||0;return Object.assign({},x,{Percentage:t?Math.round(c/t*10000)/100:0});});return json_({ok:true,projects:p.filter(x=>String(x.Status).toLowerCase()!=='completed').length,beneficiaries:b.length,indicators:i.length,completed,indicatorPerformance:indicators});}
function doPost(e){try{const body=JSON.parse(e.postData.contents||'{}');const action=body.action||'create';if(action==='create')return create_(body);if(action==='update')return update_(body);if(action==='delete')return delete_(body);return json_({ok:false,error:'Unknown action'});}catch(err){return json_({ok:false,error:String(err)})}}
function create_(d){const map={project:'Projects',objective:'Objectives',activity:'Activities',indicator:'Indicators',beneficiary:'Beneficiaries',followup:'FollowUps',evidence:'Evidence',lesson:'Lessons',challenge:'Challenges'};const sheet=map[d.entity];if(!sheet)throw Error('Unsupported entity');const s=SpreadsheetApp.getActive().getSheetByName(sheet),h=HEADERS[sheet],now=new Date(),prefix=d.entity.slice(0,3).toUpperCase();const id=id_(prefix);const obj=d.data||{};const row=h.map(k=>k==='Created At'||k==='Updated At'||k==='Last Updated'?now:(obj[k]??(k.endsWith(' ID')?id:'')));s.appendRow(row);return json_({ok:true,id});}
function update_(d){const s=SpreadsheetApp.getActive().getSheetByName(d.sheet);if(!s)throw Error('Sheet not found');const values=s.getDataRange().getValues(),h=values[0],idx=h.indexOf(d.idField||h[0]);const r=values.findIndex((x,n)=>n>0&&String(x[idx])===String(d.id));if(r<1)throw Error('Record not found');Object.entries(d.data||{}).forEach(([k,v])=>{const c=h.indexOf(k);if(c>=0)s.getRange(r+1,c+1).setValue(v)});return json_({ok:true});}
function delete_(d){const s=SpreadsheetApp.getActive().getSheetByName(d.sheet);if(!s)throw Error('Sheet not found');const v=s.getDataRange().getValues(),h=v[0],c=h.indexOf(d.idField||h[0]),r=v.findIndex((x,n)=>n>0&&String(x[c])===String(d.id));if(r<1)throw Error('Record not found');s.deleteRow(r+1);return json_({ok:true});}
