function doGet(e){try{var a=e&&e.parameter?e.parameter.action:'dashboard';if(a==='currentUser')return currentUser_();permission_('read');if(a==='dashboard')return dashboard_();if(a==='alerts')return json_({ok:true,data:alerts_()});if(a==='list'){var n=e.parameter.sheet;if(!HEADERS[n])throw Error('Invalid sheet');var data=rows_(n);if(n==='Projects')data=data.filter(function(x){return projectAllowed_(x['Project ID']);});if(n==='Beneficiaries'||n==='Indicators'||n==='Activities'||n==='Objectives'||n==='FollowUps'||n==='Evidence'||n==='Lessons'||n==='Challenges'||n==='IndicatorData'||n==='Reports')data=data.filter(function(x){return projectAllowed_(x['Project ID']);});return json_({ok:true,data:data});}if(a==='beneficiary'){var b=rows_('Beneficiaries').filter(function(x){return x['Beneficiary ID']==e.parameter.id;})[0]||null;if(b&&!projectAllowed_(b['Project ID']))throw Error('Forbidden: no project access.');return json_({ok:true,beneficiary:b,followUps:rows_('FollowUps').filter(function(x){return x['Beneficiary ID']==e.parameter.id;})});}return json_({ok:true,system:'UAF Digital M&E/L',version:'5.0'});}catch(err){return json_({ok:false,error:String(err)})}}
