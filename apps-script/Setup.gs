const SHEETS={SETTINGS:'Settings',PROJECTS:'Projects',OBJECTIVES:'Objectives',ACTIVITIES:'Activities',INDICATORS:'Indicators',BENEFICIARIES:'Beneficiaries',FOLLOWUPS:'FollowUps',EVIDENCE:'Evidence',LESSONS:'Lessons',CHALLENGES:'Challenges',REPORTS:'Reports',USERS:'Users',INDICATORDATA:'IndicatorData',AUDIT:'AuditLog'};
const HEADERS={Settings:['Key','Value'],Projects:['Project ID','Project Name','Code','Description','Start Date','End Date','Status','Budget','Currency','Communities','Partners','Responsible Person','Created At'],Objectives:['Objective ID','Project ID','Objective','Description','Created At'],Activities:['Activity ID','Project ID','Objective ID','Activity','Community','Start Date','End Date','Status','Responsible Person','Budget','Actual Cost','Notes'],Indicators:['Indicator ID','Project ID','Objective ID','Indicator','Definition','Type','Baseline','Target','Current Achievement','Unit','Data Source','Frequency','Responsible Person','Last Updated'],Beneficiaries:['Beneficiary ID','Project ID','Full Name','Sex','Date of Birth','Age','Community','County','Phone','Guardian Name','School','School Status','Reason OOSC','Consent','Current Stage','Enrollment Date','Household Empowered','Retention Status','Completion Date','Story','Photo URL','Created At','Updated At'],FollowUps:['FollowUp ID','Beneficiary ID','Project ID','Date','Stage','School Status','Retention Status','Household Status','Notes','Action Required','Officer','Next FollowUp'],Evidence:['Evidence ID','Project ID','Activity ID','Indicator ID','Beneficiary ID','Date','Evidence Type','Description','Drive URL','Collected By'],Lessons:['Lesson ID','Project ID','Date','Lesson','What Worked','What Did Not Work','Recommendation','Recorded By'],Challenges:['Challenge ID','Project ID','Date','Challenge','Impact','Action Taken','Recommendation','Status','Responsible Person'],Reports:['Report ID','Project ID','Report Type','Period Start','Period End','Generated At','Generated By','Drive URL'],Users:['User ID','Name','Email','Role','Project Access','Status'],IndicatorData:['Record ID','Indicator ID','Project ID','Period','Period Type','Achievement','Notes','Reported By','Reported At'],AuditLog:['Log ID','Timestamp','User Email','Action','Entity','Record ID','Details']};
function setupUAFMEL(){var ss=SpreadsheetApp.getActive();Object.keys(HEADERS).forEach(function(n){var s=ss.getSheetByName(n)||ss.insertSheet(n);if(s.getLastRow()==0)s.appendRow(HEADERS[n]);s.setFrozenRows(1);});var s=ss.getSheetByName('Settings');var defaults={Organization:'Upskill Africa Foundation','System Name':'UAF Digital M&E/L System',Version:'3.0','Default Currency':'USD','Beneficiary Journey':'Identified → Verified → Referred → Enrolled → Household Empowered → Follow-up → Retained → Completed'};var old=rows_('Settings');Object.keys(defaults).forEach(function(k){if(!old.some(function(x){return x.Key==k;}))s.appendRow([k,defaults[k]]);});return 'Setup complete; existing data preserved.';}
function json_(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON)}
function rows_(name){var s=SpreadsheetApp.getActive().getSheetByName(name);if(!s||s.getLastRow()<2)return [];var h=s.getRange(1,1,1,s.getLastColumn()).getValues()[0];return s.getRange(2,1,s.getLastRow()-1,s.getLastColumn()).getValues().map(function(r){var o={};h.forEach(function(k,i){o[k]=r[i];});return o;});}
function id_(p){return p+'-'+Utilities.getUuid().slice(0,8).toUpperCase()}
function actor_(){try{return Session.getActiveUser().getEmail()||Session.getEffectiveUser().getEmail()||'system';}catch(e){return 'system';}}
function audit_(a,e,id,d){var s=SpreadsheetApp.getActive().getSheetByName('AuditLog');if(s)s.appendRow([id_('LOG'),new Date(),actor_(),a,e,id,JSON.stringify(d||{})]);}
function doGet(e){var a=e&&e.parameter?e.parameter.action:'dashboard';if(a=='dashboard')return dashboard_();if(a=='list')return json_({ok:true,data:rows_(e.parameter.sheet)});if(a=='currentUser')return currentUser_();if(a=='beneficiary')return json_({ok:true,beneficiary:rows_('Beneficiaries').filter(function(x){return x['Beneficiary ID']==e.parameter.id;})[0]||null,followUps:rows_('FollowUps').filter(function(x){return x['Beneficiary ID']==e.parameter.id;})});return json_({ok:true,system:'UAF Digital M&E/L',version:'3.0'});}
function currentUser_(){var e=actor_(),u=rows_('Users').filter(function(x){return String(x.Email).toLowerCase()==String(e).toLowerCase()&&String(x.Status).toLowerCase()!='inactive';})[0]||null;return json_({ok:true,email:e,authorized:!!u,user:u});}
function dashboard_(){var p=rows_('Projects'),b=rows_('Beneficiaries'),i=rows_('Indicators'),done=b.filter(function(x){return String(x['Current Stage']).toLowerCase()=='completed';}).length;var ip=i.map(function(x){var t=Number(x.Target)||0,c=Number(x['Current Achievement'])||0,q=t?Math.round(c/t*10000)/100:0;return Object.assign({},x,{Percentage:q,RAG:q>=100?'Green':q>=70?'Amber':'Red'});});var stages={};['Identified','Verified','Referred','Enrolled','Household Empowered','Follow-up','Retained','Completed'].forEach(function(s){stages[s]=b.filter(function(x){return x['Current Stage']==s;}).length;});return json_({ok:true,projects:p.filter(function(x){return String(x.Status).toLowerCase()!='completed'&&String(x.Status).toLowerCase()!='inactive';}).length,beneficiaries:b.length,indicators:i.length,completed:done,indicatorPerformance:ip,stageCounts:stages});}
function doPost(e){try{var d=JSON.parse(e.postData.contents||'{}'),a=d.action||'create';if(a=='create')return create_(d);if(a=='update')return update_(d);if(a=='delete')return delete_(d);if(a=='moveBeneficiary')return moveBeneficiary_(d);if(a=='recordIndicator')return recordIndicator_(d);if(a=='generateReport')return generateReport_(d);if(a=='initializeStage3')return json_({ok:true,message:setupUAFMEL()});return json_({ok:false,error:'Unknown action'});}catch(err){return json_({ok:false,error:String(err)})}}
function create_(d){var map={project:'Projects',objective:'Objectives',activity:'Activities',indicator:'Indicators',beneficiary:'Beneficiaries',followup:'FollowUps',evidence:'Evidence',lesson:'Lessons',challenge:'Challenges'};var n=map[d.entity];if(!n)throw Error('Unsupported entity');var s=SpreadsheetApp.getActive().getSheetByName(n),h=HEADERS[n],o=d.data||{},now=new Date(),id=id_(d.entity.slice(0,3).toUpperCase());s.appendRow(h.map(function(k){return (k=='Created At'||k=='Updated At'||k=='Last Updated')?now:(o[k]!==undefined?o[k]:(k.indexOf(' ID')>0?id:''));}));audit_('CREATE',d.entity,id,o);return json_({ok:true,id:id});}
function update_(d){var s=SpreadsheetApp.getActive().getSheetByName(d.sheet);if(!s)throw Error('Sheet not found');var v=s.getDataRange().getValues(),h=v[0],c=h.indexOf(d.idField||h[0]),r=v.findIndex(function(x,n){return n>0&&String(x[c])==String(d.id);});if(r<1)throw Error('Record not found');Object.keys(d.data||{}).forEach(function(k){var q=h.indexOf(k);if(q>=0)s.getRange(r+1,q+1).setValue(d.data[k]);});audit_('UPDATE',d.sheet,d.id,d.data);return json_({ok:true});}
function delete_(d){var s=SpreadsheetApp.getActive().getSheetByName(d.sheet);if(!s)throw Error('Sheet not found');var v=s.getDataRange().getValues(),h=v[0],c=h.indexOf(d.idField||h[0]),r=v.findIndex(function(x,n){return n>0&&String(x[c])==String(d.id);});if(r<1)throw Error('Record not found');s.deleteRow(r+1);audit_('DELETE',d.sheet,d.id,d);return json_({ok:true});}
function moveBeneficiary_(d){var allowed=['Identified','Verified','Referred','Enrolled','Household Empowered','Follow-up','Retained','Completed'];if(allowed.indexOf(d.stage)<0)throw Error('Invalid stage');var s=SpreadsheetApp.getActive().getSheetByName('Beneficiaries'),v=s.getDataRange().getValues(),h=v[0],c=h.indexOf('Beneficiary ID'),r=v.findIndex(function(x,n){return n>0&&String(x[c])==String(d.id);});if(r<1)throw Error('Beneficiary not found');s.getRange(r+1,h.indexOf('Current Stage')+1).setValue(d.stage);if(h.indexOf('Updated At')>=0)s.getRange(r+1,h.indexOf('Updated At')+1).setValue(new Date());audit_('STAGE_CHANGE','Beneficiary',d.id,{stage:d.stage});return json_({ok:true,id:d.id,stage:d.stage});}
function recordIndicator_(d){var ind=rows_('Indicators').filter(function(x){return String(x['Indicator ID'])==String(d.indicatorId);})[0];if(!ind)throw Error('Indicator not found');var s=SpreadsheetApp.getActive().getSheetByName('IndicatorData'),n=Number((d.data||{}).Achievement)||0,rid=id_('INDD');s.appendRow([rid,d.indicatorId,ind['Project ID'],(d.data||{}).Period||'',(d.data||{})['Period Type']||'Monthly',n,(d.data||{}).Notes||'',actor_(),new Date()]);return json_({ok:true,id:rid});}
function generateReport_(d){var p=rows_('Projects').filter(function(x){return String(x['Project ID'])==String(d.projectId);})[0];if(!p)throw Error('Project not found');var b=rows_('Beneficiaries').filter(function(x){return String(x['Project ID'])==String(d.projectId);}),i=rows_('Indicators').filter(function(x){return String(x['Project ID'])==String(d.projectId);}),doc=DocumentApp.create('UAF '+(d.reportType||'M&E Report')+' - '+p['Project Name']),body=doc.getBody();body.appendParagraph('Upskill Africa Foundation').setHeading(DocumentApp.ParagraphHeading.TITLE);body.appendParagraph(d.reportType||'M&E Report').setHeading(DocumentApp.ParagraphHeading.HEADING1);body.appendParagraph('Project: '+p['Project Name']+' ('+p['Code']+')');body.appendParagraph('Period: '+(d.periodStart||'')+' to '+(d.periodEnd||''));body.appendParagraph('Beneficiaries registered: '+b.length);body.appendParagraph('Beneficiaries completed: '+b.filter(function(x){return x['Current Stage']=='Completed';}).length);i.forEach(function(x){var t=Number(x.Target)||0,c=Number(x['Current Achievement'])||0;body.appendListItem(x.Indicator+': '+c+' / '+t+' '+(x.Unit||'')+' ('+(t?Math.round(c/t*10000)/100:0)+'%)');});doc.saveAndClose();var url=doc.getUrl(),rs=SpreadsheetApp.getActive().getSheetByName('Reports');if(rs)rs.appendRow([id_('RPT'),d.projectId,d.reportType||'M&E Report',d.periodStart||'',d.periodEnd||'',new Date(),actor_(),url]);audit_('REPORT_GENERATED','Report',d.projectId,{url:url});return json_({ok:true,url:url});}
