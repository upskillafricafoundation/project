function initializeStage3(){var ss=SpreadsheetApp.getActive();['IndicatorData','AuditLog'].forEach(function(n){var s=ss.getSheetByName(n)||ss.insertSheet(n);if(s.getLastRow()==0)s.appendRow(n=='IndicatorData'?['Record ID','Indicator ID','Project ID','Period','Period Type','Achievement','Notes','Reported By','Reported At']:['Log ID','Timestamp','User Email','Action','Entity','Record ID','Details']);s.setFrozenRows(1);});return 'Stage 3 initialized';}
function stage3CurrentUser(){var e=Session.getActiveUser().getEmail()||Session.getEffectiveUser().getEmail();var u=rows_('Users').filter(function(x){return String(x.Email).toLowerCase()==String(e).toLowerCase()&&String(x.Status).toLowerCase()!='inactive';})[0]||null;return json_({ok:true,email:e||'system',authorized:!!u,user:u});}
function stage3MoveBeneficiary(id,stage){var a=['Identified','Verified','Referred','Enrolled','Household Empowered','Follow-up','Retained','Completed'];if(a.indexOf(stage)<0)throw Error('Invalid stage');var s=SpreadsheetApp.getActive().getSheetByName('Beneficiaries'),v=s.getDataRange().getValues(),h=v[0],ic=h.indexOf('Beneficiary ID'),sc=h.indexOf('Current Stage'),uc=h.indexOf('Updated At'),r=v.findIndex(function(x,n){return n>0&&String(x[ic])==String(id);});if(r<1)throw Error('Beneficiary not found');s.getRange(r+1,sc+1).setValue(stage);if(uc>=0)s.getRange(r+1,uc+1).setValue(new Date());return json_({ok:true,id:id,stage:stage});}
function stage3RecordIndicator(id,d){var ind=rows_('Indicators').filter(function(x){return String(x['Indicator ID'])==String(id);})[0];if(!ind)throw Error('Indicator not found');var s=SpreadsheetApp.getActive().getSheetByName('IndicatorData');var rid='INDD-'+Utilities.getUuid().slice(0,8).toUpperCase();s.appendRow([rid,id,ind['Project ID'],d.Period||'',d['Period Type']||'Monthly',Number(d.Achievement)||0,d.Notes||'',Session.getEffectiveUser().getEmail(),new Date()]);return json_({ok:true,id:rid});}
function stage3GenerateReport(projectId,type,start,end){var p=rows_('Projects').filter(function(x){return String(x['Project ID'])==String(projectId);})[0];if(!p)throw Error('Project not found');var b=rows_('Beneficiaries').filter(function(x){return String(x['Project ID'])==String(projectId);}),i=rows_('Indicators').filter(function(x){return String(x['Project ID'])==String(projectId);}),doc=DocumentApp.create('UAF '+(type||'M&E Report')+' - '+p['Project Name']),body=doc.getBody();body.appendParagraph('Upskill Africa Foundation').setHeading(DocumentApp.ParagraphHeading.TITLE);body.appendParagraph(type||'M&E Report').setHeading(DocumentApp.ParagraphHeading.HEADING1);body.appendParagraph('Project: '+p['Project Name']+' ('+p['Code']+')');body.appendParagraph('Period: '+(start||'')+' to '+(end||''));body.appendParagraph('Beneficiaries: '+b.length+' | Completed: '+b.filter(function(x){return x['Current Stage']=='Completed';}).length);i.forEach(function(x){var t=Number(x.Target)||0,c=Number(x['Current Achievement'])||0;body.appendListItem(x.Indicator+': '+c+' / '+t+' '+(x.Unit||'')+' ('+(t?Math.round(c/t*10000)/100:0)+'%)');});doc.saveAndClose();return json_({ok:true,url:doc.getUrl()});}
